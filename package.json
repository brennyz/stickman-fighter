{
  "name": "stickman-fighter",
  "private": true,
  "version": "1.18.63",
  "description": "Stickman Fighter — Monster Arena PWA",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:css": "node scripts/extract-css.mjs",
    "split": "node scripts/split-game.mjs",
    "check": "node --check game.js",
    "smoke": "node scripts/smoke-load-game.mjs",
    "smoke:upgrades": "node scripts/smoke-upgrades.mjs",
    "smoke:menu": "node scripts/smoke-menu-hub.mjs",
    "smoke:html": "node scripts/smoke-html-structure.mjs",
    "test": "npm run build && npm run check && npm run smoke && npm run smoke:upgrades && npm run smoke:menu && npm run smoke:html",
    "roll": "bash scripts/roll-improvement-d20.sh",
    "roll:status": "bash scripts/roll-improvement-d20.sh status",
    "roll:verify": "bash scripts/roll-improvement-d20.sh verify",
    "roll:doctor": "bash scripts/roll-improvement-d20.sh doctor",
    "d20:done": "bash scripts/mark-d20-done.sh"
  }
}
