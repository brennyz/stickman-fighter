# Local signing — DO NOT COMMIT real values.
# Copy to keystore.properties and fill in privately.

storeFile=upload-keystore.jks
storePassword=REPLACE_ME_STORE_PASSWORD
keyAlias=upload
keyPassword=REPLACE_ME_KEY_PASSWORD

# Optional Play App Signing note:
# - upload key = this keystore (you keep)
